# Monad testnet deploy. Fill these in .env only. Never commit .env.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_ADDRESS=
MONAD_PRIVATE_KEY=
BIDDER_ADDRESS=
BIDDER_PRIVATE_KEY=

# Optional Demo.s.sol deadline offsets, in seconds. Omit them to use 1h, 2h, and 3h.
# COMMIT_DELAY_SECONDS=60
# REVEAL_DELAY_SECONDS=120
# CANCEL_DELAY_SECONDS=180

# The web app needs no env vars. Contract addresses live in apps/web/src/config.ts.
