# Monad testnet deploy. Fill these in .env only. Never commit .env.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_ADDRESS=
MONAD_PRIVATE_KEY=
BIDDER_ADDRESS=
BIDDER_PRIVATE_KEY=

# Optional Demo.s.sol deadline offsets, in seconds. Omit them to use 1h, 2h, and 3h.
# COMMIT_DELAY_SECONDS=60
# REVEAL_DELAY_SECONDS=120
# CANCEL_DELAY_SECONDS=180

# Public frontend configuration
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BLINDLAUNCH_PROGRAM_ID=
NEXT_PUBLIC_QUOTE_MINT=

# Private script configuration — never expose with NEXT_PUBLIC_
SOLANA_RPC_URL=https://api.devnet.solana.com
AUCTION_AUTHORITY_KEYPAIR_PATH=
ARCIUM_CLUSTER=
METEORA_POOL_CONFIG=
