# One file per keeper (keeper0.env, keeper1.env, keeper2.env). Never commit filled-in copies.
KEEPER_INDEX=0
# Owner of this keeper's queue in KeeperRegistry; also pays gas. Fund it with MON.
KEEPER_PRIVATE_KEY=
# Use a different RPC provider for each keeper: the chain time a keeper publishes against comes from it.
RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYMENT=../../deployments/10143.json
# This keeper's secret keys. Back it up; losing it means this keeper cannot publish for auctions already using its keys.
KEY_STORE=./keeper0.keys.json
QUEUE_TARGET=20
POLL_MS=2000
